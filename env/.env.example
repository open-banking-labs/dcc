# ============================================
# DCC project environment configuration template
#
# Development environment: copy to dev.env for use
# Production environment: generated dynamically by the deployment script
#
# Password fields are intentionally left empty.
# - dev: scripts/dcc-start.sh generates random values automatically
# - prod: scripts/dcc-deploy.sh requires them via environment variables
#
# Naming convention (keep these in sync with docs/DEVOPS.md):
#   - SCREAMING_SNAKE_CASE, always prefixed with the owning service:
#     POSTGRES_* / REDIS_* / RABBITMQ_* / MINIO_* / ADMINER_*
#   - Ports: <SERVICE>_HOST_PORT, or <SERVICE>_<ROLE>_HOST_PORT when a
#     service exposes more than one (RABBITMQ_AMQP_, MINIO_CONSOLE_, ...)
#   - Passwords: <SERVICE>_PASSWORD. MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
#     are the one exception - they are MinIO's own container contract and
#     are passed through verbatim.
# ============================================

# ---------- Basic configuration ----------
ENV=dev
PROJECT_NAME=dcc
TZ=Asia/Shanghai
RESTART_POLICY=unless-stopped

# ---------- PostgreSQL ----------
POSTGRES_VERSION=18-alpine
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5432
POSTGRES_DB=dcc_dev
POSTGRES_USER=dcc_user
POSTGRES_PASSWORD=
POSTGRES_MEMORY_LIMIT=512M
POSTGRES_MEMORY_RESERVATION=256M

# ---------- Redis (optional) ----------
REDIS_VERSION=7-alpine
REDIS_HOST_PORT=6379
REDIS_PASSWORD=
REDIS_MAX_MEMORY=256mb
REDIS_MEMORY_LIMIT=256M

# ---------- RabbitMQ (optional) ----------
RABBITMQ_VERSION=4-management-alpine
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/dcc
RABBITMQ_MEMORY_LIMIT=512M

# ---------- MinIO (optional) ----------
MINIO_VERSION=latest
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9090
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_CONSOLE_URL=http://localhost:9090
MINIO_MEMORY_LIMIT=1G

# ---------- Adminer (optional) ----------
ADMINER_VERSION=latest
# 8081, not 8080: the Spring app already binds 8080 (server.port)
ADMINER_HOST_PORT=8081
ADMINER_THEME=dracula

# ---------- Edge gateway (Traefik) ----------
# Only the gateway publishes a host port; dcc-web/dcc-mcp are reachable only
# through it (their ports are not published).
GATEWAY_HOST_PORT=8080
TRAEFIK_VERSION=v3.1
GATEWAY_RATE_AVERAGE=20
GATEWAY_RATE_BURST=40

# ---------- Application (dcc-app service; no published host port) ----------
APP_MEMORY_LIMIT=512M
APP_MEMORY_RESERVATION=256M

# ---------- MCP (dcc-mcp service; no published host port) ----------
MCP_MEMORY_LIMIT=512M
MCP_MEMORY_RESERVATION=256M

# ---------- Health checks ----------
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=5
